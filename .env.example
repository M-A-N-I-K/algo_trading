# PostgreSQL connection string (Prisma).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Binance (used by the CLI backtest scripts under src/backtest/)
BASE_API=https://api.binance.com
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# CoinDCX (used by the "Sync Now" button on the Import page to pull trade history)
COINDCX_BASE_API=https://api.coindcx.com
COINDCX_API_KEY=
COINDCX_SECRET_KEY=

# Optional: Google API key, if used elsewhere.
GOOGLE_API_KEY=

# CLI backtest defaults (see src/backtest/run.ts) — all optional.
BACKTEST_SYMBOL=BTCUSDT,ETHUSDT,XRPUSDT
BACKTEST_INTERVAL=1h
BACKTEST_LIMIT=1000
BACKTEST_STRATEGY=macd-200ema-sr
BACKTEST_INITIAL_BALANCE=10000
BACKTEST_MAX_RISK=0.02

# Folder the MT5 PB_BarFeed service writes candles to (mt5/README.md, "Live candle
# feed"). Defaults to the Mac MT5 app's MQL5/Files/PlaybookFeed.
MT5_FEED_DIR=
# Once a day the app deletes, inside that MT5 terminal's folder only, daily logs older than
# MT5_KEEP_LOG_DAYS and 1-minute history/tick files from before the last MT5_KEEP_HISTORY_YEARS
# (this year included; 0 keeps everything). MT5 re-downloads a year if a Strategy Tester run needs it.
MT5_KEEP_LOG_DAYS=30
MT5_KEEP_HISTORY_YEARS=7
# `pnpm dev` clears Next's dev cache (.next/dev/cache) when it grows past this many MB.
NEXT_CACHE_MAX_MB=1500

# Live MT5 sync: only these signed-in users (comma-separated) may link and sync MT5 logins. Unset: live sync is off.
MT5_SYNC_EMAILS=

# MetaApi API token (app.metaapi.cloud/token): connect MT5 accounts through MetaApi's cloud,
# with their investor password, so they sync without the MT5 app running. Paid per account.
METAAPI_TOKEN=
