datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Local / Basic Auth fields (optional if they use Google Login)
  username     String?   @unique
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  trades       Trade[]

  // Baseline balance the equity curve and account-growth % are measured
  // from, for trades that don't carry their own balanceBefore. Editable
  // from Settings.
  startingBalance Float @default(100000)

  // Daily/weekly max-loss thresholds shown on the dashboard's loss-limit
  // banner. Null means "not set yet" — the banner falls back to 4%/8% of
  // the most recent known balance until the user picks explicit values.
  dailyLossLimit  Float?
  weeklyLossLimit Float?

  // Strategy key (see src/lib/strategyCatalog.ts) pre-filled for new
  // manual trade entries and CSV imports, instead of a hardcoded strategy
  // that may have nothing to do with what the user actually trades.
  defaultStrategy String @default("macd-200ema-sr")

  // Card keys (see KPI_CARD_KEYS in KPICards.tsx) the user has hidden from
  // the dashboard's KPI row. Empty = show everything.
  hiddenKpiCards String[] @default([])

  // Live CoinDCX futures wallet balance (USDT, free + locked), pulled on
  // demand from Settings — the loss-limit banner's 4%/8% auto-calculated
  // defaults use this (when synced at least once) instead of inferring a
  // balance from trade history, so daily/weekly risk tracks the real
  // account size rather than a guess.
  coindcxBalance         Float?
  coindcxBalanceSyncedAt DateTime?

  // P&L on each prop account before trades were logged in the playbook, so
  // the playbook's balance matches the platform's: { "<account id>": $ }.
  // Account ids are in PLAYBOOK_ACCOUNTS (src/lib/playbook/config.ts). Set
  // from the playbook page by entering the platform balance.
  playbookPriorPnls Json @default("{}")
  // Legacy: the same for the single $5k account the playbook had before it
  // had accounts. No longer read.
  playbookPriorPnl  Float @default(0)

  tradingAccounts TradingAccount[]
  riskProfiles    RiskProfile[]
  strategies      Strategy[]
  backtests       Backtest[]
  backtestRuns    BacktestRun[]
  walletTransactions CoindcxWalletTransaction[]
  playbookTrades  PlaybookTrade[]
  mt5Trades       Mt5Trade[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Trade {
  id            String   @id @default(uuid())
  time          DateTime
  balanceBefore Float?
  balanceAfter  Float?
  pnl           Float
  currency      String   @default("USD")
  symbol        String
  exchange      String   @default("UNKNOWN")
  side          String   // LONG or SHORT
  quantity      Float
  entryPrice    Float
  exitPrice     Float
  strategy      String   @default("macd-200ema-sr")
  notes         String   @default("")

  stopLoss           Float?
  initialRiskAmount  Float?   // $ amount risked at entry (|entryPrice - stopLoss| * quantity); R-multiple = pnl / initialRiskAmount
  fees               Float?   // exchange trading fee charged to open+close this trade; already netted into pnl, stored separately for fee reporting

  // Exchange-synced P&L breakdown (all USDT): pnl = grossPnl - fees + funding.
  // grossPnl is the exchange's own realized P&L; funding is the signed sum of
  // funding settlements while the round trip was open. Null for manual trades.
  openedAt           DateTime? // when the round trip opened (time = when it closed)
  grossPnl           Float?
  funding            Float?
  marginCurrency     String?  // "USDT" | "INR" — the position's margin currency
  netPnlNative       Float?   // net P&L in marginCurrency, for checking against CoinDCX
  exitType           String?  // "manual" | "tpsl" | "liquidation"
  tags               String[] @default([])
  checklist          Json?    // [{ label: string, checked: boolean }]

  // Dedup key for trades synced from an exchange API. CoinDCX futures round
  // trips use "rt:<positionId>:<firstFillId>". Null for manually-entered trades.
  externalId    String?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  createdAt     DateTime @default(now())

  @@unique([userId, exchange, externalId])
  @@map("trades")
}

// CoinDCX's futures position ledger (/derivatives/futures/positions/transactions),
// replaced wholesale on every sync. It is the source of truth that Trade
// round trips are reconciled from (see src/lib/coindcx/reconcile.ts).
// `stage` is CoinDCX's raw event type: "funding" (parentType
// "...::FundingSnapshot") is a signed funding settlement; order stages
// ("default" / "exit" / "tpsl_exit" / "liquidate", parentType "...::Order")
// carry the exchange's realized P&L (`amount`) and fee for one fill.
model CoindcxWalletTransaction {
  id         String   @id @default(uuid())
  stage      String
  parentType String
  symbol     String
  amount     Float
  feeAmount  Float
  currency   String
  occurredAt DateTime

  positionId       String  @default("")
  marginCurrency   String  @default("USDT")
  nativeAmount     Float   @default(0) // amount in marginCurrency (amount/feeAmount are USDT)
  nativeFeeAmount  Float   @default(0)
  // Where reconciliation put this row: "trade" (tradeExternalId set),
  // "open" (position still open) or "unattributed" (no matching round trip).
  attribution      String  @default("unattributed")
  tradeExternalId  String?

  // CoinDCX's own fill_id for this ledger row — a real unique id, unlike
  // the /wallets/transactions endpoint this replaced.
  externalId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@unique([userId, externalId])
  @@map("coindcx_wallet_transactions")
}

// ---------------------------------------------------------------------------
// Trading Lab P0: market data, risk profiles, and strategy/backtest
// foundation. All additive — no existing model above is modified.
// ---------------------------------------------------------------------------

// A trading account (balance/equity), distinct from NextAuth's `Account`
// (OAuth linking) model above, which already owns the "accounts" table name.
model TradingAccount {
  id            String   @id @default(uuid())
  userId        String
  name          String
  currency      String   @default("INR")
  balance       Decimal  @db.Decimal(18, 4)
  broker        String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskProfiles  RiskProfile[]

  @@index([userId])
  @@map("trading_accounts")
}

enum AssetType {
  STOCK
  INDEX
  FUTURE
  OPTION
  ETF
  CRYPTO
  FOREX
}

model Instrument {
  id         String    @id @default(uuid())
  symbol     String
  exchange   String
  assetType  AssetType
  currency   String    @default("INR")
  // Decimal-safe: smallest price increment and smallest tradable quantity
  // increment. Both stored as Decimal, never float, since they gate
  // rounding/validation for every position-size calculation.
  tickSize   Decimal   @db.Decimal(18, 8)
  lotSize    Decimal   @db.Decimal(18, 8)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  candles      Candle[]
  riskProfiles RiskProfile[]

  @@unique([symbol, exchange])
  @@index([assetType])
  @@map("instruments")
}

enum Timeframe {
  M1
  M5
  M15
  M30
  H1
  H4
  D1
}

model Candle {
  id           String     @id @default(uuid())
  instrumentId String
  timestamp    DateTime
  timeframe    Timeframe
  // OHLCV stored as Decimal — never JS float — since candle values feed
  // directly into risk/backtest calculations downstream.
  open         Decimal    @db.Decimal(18, 8)
  high         Decimal    @db.Decimal(18, 8)
  low          Decimal    @db.Decimal(18, 8)
  close        Decimal    @db.Decimal(18, 8)
  volume       Decimal    @db.Decimal(24, 8)
  // Demo/seeded candles must never be mistaken for real market data.
  isDemo       Boolean    @default(true)

  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  // Covers "all candles for instrument + timeframe + date range" and
  // "latest candles for instrument" query patterns.
  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe, timestamp])
  @@map("candles")
}

model RiskProfile {
  id               String   @id @default(uuid())
  userId           String
  tradingAccountId String?
  instrumentId     String?
  name             String
  symbol           String
  direction        String // LONG or SHORT
  entryPrice       Decimal  @db.Decimal(18, 8)
  stopLoss         Decimal  @db.Decimal(18, 8)
  takeProfit       Decimal? @db.Decimal(18, 8)
  riskPercent      Decimal  @db.Decimal(8, 4)
  // Snapshot of the computed result at save time, so a saved profile
  // reflects what the trader actually saw — not a live recalculation that
  // could silently drift if instrument/account data changes later.
  result           Json

  createdAt        DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccount  TradingAccount? @relation(fields: [tradingAccountId], references: [id], onDelete: SetNull)
  instrument      Instrument?     @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("risk_profiles")
}

// DRAFT: incomplete, freely editable. READY: passed validateStrategyDefinition
// and can be backtested. ARCHIVED: retired, kept for history.
enum StrategyStatus {
  DRAFT
  READY
  ARCHIVED
}

// Relational metadata for fast listing/filtering — the full StrategyDefinition
// (entry/exit/risk/positionSizing/...) lives in StrategyVersion.configuration.
// name/market/timeframe/status here are denormalized from the latest
// version's definition at save time.
model Strategy {
  id          String         @id @default(uuid())
  userId      String
  name        String
  description String         @default("")
  market      String
  timeframe   Timeframe
  status      StrategyStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  StrategyVersion[]
  backtests Backtest[]

  @@index([userId])
  @@map("strategies")
}

// Strategy configuration is versioned and immutable — a new version is
// always inserted, never overwritten, so backtests stay reproducible
// against the exact configuration that produced them.
model StrategyVersion {
  id          String   @id @default(uuid())
  strategyId  String
  version     Int
  // The full, Zod-validated StrategyDefinition JSON (src/domain/strategies).
  configuration Json
  // Optional human/auto-generated note describing what changed vs. the
  // previous version (see src/domain/strategies/diff.ts).
  changeNote  String?
  createdAt   DateTime @default(now())

  strategy  Strategy   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  backtests Backtest[]

  @@unique([strategyId, version])
  @@map("strategy_versions")
}

enum BacktestStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Foundation only for P0 — no execution engine wired up yet (see
// src/domain/backtesting for the placeholder interfaces).
model Backtest {
  id                String         @id @default(uuid())
  strategyId        String
  strategyVersionId String
  userId            String
  status            BacktestStatus @default(PENDING)
  // Run configuration (date range, symbol, timeframe, initial capital, ...).
  configuration     Json
  // Populated only once status = COMPLETED: { metrics, equityCurve, drawdownCurve }.
  metrics           Json?
  // Why a FAILED run failed, in words the results page can show.
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())

  strategy        Strategy        @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades          BacktestTrade[]

  @@index([strategyId])
  @@index([userId])
  @@map("backtests")
}

model BacktestTrade {
  id           String   @id @default(uuid())
  backtestId   String
  side         String // LONG or SHORT
  entryTime    DateTime
  entryPrice   Decimal  @db.Decimal(18, 8)
  exitTime     DateTime
  exitPrice    Decimal  @db.Decimal(18, 8)
  quantity     Decimal  @db.Decimal(18, 8)
  fees         Decimal  @db.Decimal(18, 8) @default(0)
  slippage     Decimal  @db.Decimal(18, 8) @default(0)
  pnl          Decimal  @db.Decimal(18, 4)
  rMultiple    Decimal? @db.Decimal(10, 4)
  mae          Decimal? @db.Decimal(18, 4) // Maximum Adverse Excursion
  mfe          Decimal? @db.Decimal(18, 4) // Maximum Favorable Excursion
  // stop | trailing-stop | target | signal | time | end-of-data
  exitType     String?
  // Every exit fill of the round trip: [{ time, price, quantity, exitType, grossPnl, fee }]
  legs         Json?

  backtest Backtest @relation(fields: [backtestId], references: [id], onDelete: Cascade)

  @@index([backtestId])
  @@map("backtest_trades")
}

// Stores a completed run from the legacy hardcoded-strategy backtest engine
// (src/strategies/*, src/app/api/backtest/route.ts) — distinct from the
// Backtest model above, which is scoped to the newer Strategy Builder's
// versioned StrategyDefinition and requires a strategyId/strategyVersionId
// FK that legacy runs don't have. `results` mirrors exactly what the API
// returns to the client (already bounded to the last 100 trades / 500
// equity points per symbol), so history playback needs no recomputation.
model BacktestRun {
  id                 String   @id @default(uuid())
  userId             String
  strategyKey        String
  strategyName       String
  symbols            String
  interval           String
  candleLimit        Int
  initialBalance     Decimal  @db.Decimal(18, 2)
  minRiskRewardRatio Decimal? @db.Decimal(10, 4)
  results            Json
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("backtest_runs")
}

// A trade taken from the playbook (src/lib/playbook): one of the backtested
// strategy/market setups, sized and checked against the prop firm's rules
// before entry, then closed with the platform's real P&L. Open trades live
// here too, so the pre-trade checks can count open risk and free slots.
model PlaybookTrade {
  id             String    @id @default(uuid())
  userId         String
  accountId      String    @default("flex-10k") // which prop account, as in PLAYBOOK_ACCOUNTS
  setupId        String    // "<strategy>:<symbol>:<interval>", as in PLAYBOOK_SETUPS
  symbol         String
  strategy       String
  interval       String
  side           String    // LONG or SHORT
  grade          String?   // A or B: where entry sat in last week's range
  status         String    @default("OPEN") // OPEN or CLOSED
  entryTime      DateTime
  entryPrice     Float
  stopLoss       Float
  takeProfit     Float?
  quantity       Float     // coins, ounces or units of the base currency
  lots           Float?
  riskAmount     Float     // $ lost if the stop is hit
  checks         Json      // the pre-trade checks as they stood at entry
  rulesFollowed  Boolean   // no rule broken and every manual check ticked
  overrideReason String    @default("") // why it was taken anyway
  exitTime       DateTime?
  exitPrice      Float?
  pnl            Float?    // $ from the platform: spread, commission and swap included
  rMultiple      Float?    // pnl / riskAmount
  exitReason     String?   // stop, target, breakeven or manual
  mistakes       String[]  @default([])
  notes          String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, accountId, status])
  @@map("playbook_trades")
}

// A position from a MetaTrader 5 account (the FundingPips prop account),
// imported from MT5's "Trade History Report" (src/lib/mt5). Kept apart from
// the CoinDCX-shaped Trade table. Times are converted from MT5 server time
// to UTC. Re-importing a report updates rows by (userId, login, positionId).
model Mt5Trade {
  id          String    @id @default(uuid())
  userId      String
  login       String    // MT5 account number
  server      String    // e.g. FundingPips-SIM1
  positionId  String    // MT5 position ticket
  symbol      String    // as MT5 names it: XAUUSD, ETHUSD, NDX100 ...
  side        String    // LONG or SHORT
  volume      Float     // lots
  status      String    // OPEN or CLOSED
  openTime    DateTime
  openPrice   Float
  stopLoss    Float?
  takeProfit  Float?
  closeTime   DateTime?
  closePrice  Float?
  commission  Float     @default(0) // $, negative = paid
  swap        Float     @default(0) // $, negative = paid
  profit      Float?    // $ price P&L (closed) or floating P&L (open)
  netPnl      Float?    // profit + commission + swap
  exitReason  String?   // stop, target or manual
  importedAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, login, positionId])
  @@index([userId, openTime])
  @@map("mt5_trades")
}
