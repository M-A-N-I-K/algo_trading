datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Local / Basic Auth fields (optional if they use Google Login)
  username     String?   @unique
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  trades       Trade[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Trade {
  id            String   @id @default(uuid())
  time          DateTime
  balanceBefore Float?
  balanceAfter  Float?
  pnl           Float
  currency      String   @default("USD")
  symbol        String
  exchange      String   @default("UNKNOWN")
  side          String   // LONG or SHORT
  quantity      Float
  entryPrice    Float
  exitPrice     Float
  strategy      String   @default("macd-200ema-sr")
  notes         String   @default("")

  stopLoss           Float?
  initialRiskAmount  Float?   // $ amount risked at entry (|entryPrice - stopLoss| * quantity); R-multiple = pnl / initialRiskAmount
  tags               String[] @default([])
  checklist          Json?    // [{ label: string, checked: boolean }]

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  createdAt     DateTime @default(now())

  @@unique([userId, time, pnl])
  @@map("trades")
}
